{
  "name": "visionaryx-operations",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply visionaryx-ops --local",
    "db:migrate:remote": "wrangler d1 migrations apply visionaryx-ops --remote",
    "db:seed:local": "node scripts/seed.mjs && wrangler d1 execute visionaryx-ops --local --file=.seed/seed.sql > /dev/null && echo Seed applied.",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed:local",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.2",
    "hono": "^4.13.13",
    "lucide-react": "^1.57.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.2",
    "@cloudflare/workers-types": "^5.20261014.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20261012.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}
